---
const genres = [
	'Afro House',
	'Tech House',
	'Progressive House',
	'Techno',
	'Dance',
	'Hip-Hop',
	'R&B',
	'Moombahton',
];
---

<section id="hero" class="relative flex min-h-screen items-center overflow-hidden bg-ink pt-24">
	<div class="pointer-events-none absolute inset-0 overflow-hidden">
		<div class="absolute -top-32 -left-32 h-96 w-96 rounded-full bg-accent/30 blur-[120px]"></div>
		<div class="absolute top-1/3 -right-24 h-96 w-96 rounded-full bg-accent-3/20 blur-[120px]"></div>
		<div class="absolute bottom-0 left-1/3 h-96 w-96 rounded-full bg-accent-2/20 blur-[120px]"></div>
	</div>

	<div class="relative mx-auto max-w-5xl px-6 py-20 text-center">
		<p class="mb-6 text-xs font-semibold tracking-[0.3em] text-zinc-400 uppercase">
			{genres.join(' · ')}
		</p>

		<h1 class="font-display text-5xl leading-[0.95] text-white uppercase sm:text-6xl md:text-7xl">
			DJ MAC — Where Every
			<span class="text-gradient block">Genre Finds Its Rhythm</span>
		</h1>

		<p class="mx-auto mt-8 max-w-2xl text-lg font-medium text-zinc-200 sm:text-xl">
			From hypnotic Afro House grooves to festival-sized Techno drops, DJ MAC reads every room and
			delivers exactly the energy it's craving — set after set, night after night.
		</p>

		<p class="mx-auto mt-4 max-w-xl text-base text-zinc-400">
			A genre-fluid selector who turns dancefloors into journeys, fusing underground electronic depth
			with mainstream urban firepower into one seamless set.
		</p>

		<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
			<a
				href="#booking"
				class="rounded-full bg-accent px-8 py-3 text-sm font-semibold tracking-wider text-white uppercase shadow-lg shadow-accent/30 transition hover:bg-accent-2"
			>
				Book DJ MAC
			</a>
			<a
				href="#portfolio"
				class="rounded-full border border-white/20 px-8 py-3 text-sm font-semibold tracking-wider text-white uppercase transition hover:border-white/50 hover:bg-white/5"
			>
				Listen to the Sets
			</a>
		</div>
	</div>
</section>
